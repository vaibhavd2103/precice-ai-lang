# Copy to .env and fill in your LLM settings.
# OpenRouter remains the default provider, but any OpenAI-compatible base URL can be used.

PRECICE_AI_PROVIDER=openrouter
PRECICE_AI_API_KEY=your-api-key-here
# OpenRouter chat model. Override this with any currently available OpenRouter model.
PRECICE_AI_MODEL=openai/gpt-4o-mini
# Free-tier alternative if your account has no paid credits (avoids 402 credit-limit
# errors on paid models like gpt-4o-mini). Specific vendor ":free" slugs get retired by
# OpenRouter periodically; "openrouter/free" is OpenRouter's own auto-routed option and
# tends to be more durable. Check https://openrouter.ai/models?max_price=0 for current
# free, tool-calling-capable options if this one stops working.
# PRECICE_AI_MODEL=openrouter/free
PRECICE_AI_BASE_URL=https://openrouter.ai/api/v1
# Optional JSONL activity log path (defaults to ./logs/agent.jsonl)
# PRECICE_AI_LOG_FILE=logs/agent.jsonl
# Optional legacy local-doc fallback; leave disabled to require the MCP KB.
# PRECICE_AI_ALLOW_LOCAL_SEARCH_FALLBACK=false

# Max tokens per assistant reply (default 1024). Lower this if your provider
# key returns a 402 "insufficient credits" error for the default value.
# PRECICE_AI_MAX_TOKENS=512

# Backward-compatible fallback:
# OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: host/port for the local web server
# PRECICE_AI_HOST=127.0.0.1
# PRECICE_AI_PORT=7860

# --- preCICE MCP server (sibling `precice-ai` repo) ---
# Path to the MCP server's server.py (default: ../precice-ai/server.py)
# PRECICE_AI_MCP_SERVER=/path/to/precice-ai/server.py
# Interpreter used to launch it (default: this app's Python)
# PRECICE_AI_MCP_PYTHON=/path/to/precice-ai/.venv/bin/python
# Embedding key the MCP server uses for KB queries. Defaults to PRECICE_AI_API_KEY;
# set it explicitly if your chat provider is not OpenRouter.
# OPENROUTER_API_KEY=sk-or-...
# Local KB cache directory shared with the MCP server (default: ~/.precice-ai/kb_store)
# PRECICE_KB_STORE_DIR=~/.precice-ai/kb_store
# Root folder the MCP project/config/log tools resolve project names under
# (default: the MCP repo's test-projects/)
# PRECICE_PROJECTS_DIR=/path/to/your/precice/projects
